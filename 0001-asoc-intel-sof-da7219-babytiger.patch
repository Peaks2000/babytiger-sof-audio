+static bool is_babytiger(void)
+{
+	if (!dmi_match(DMI_SYS_VENDOR, "Google"))
+		return false;
+
+	return dmi_match(DMI_PRODUCT_NAME, "Babytiger") ||
+	       dmi_match(DMI_BOARD_NAME, "Babytiger") ||
+	       (dmi_match(DMI_BOARD_NAME, "Coral") &&
+		(dmi_match(DMI_PRODUCT_SKU, "sku30") ||
+		 dmi_match(DMI_PRODUCT_SKU, "sku33")));
+}
